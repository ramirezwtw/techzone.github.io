          </div>
          <select id="hwBrandFilter" class="form-input form-input-sm" aria-label="Filtrar por marca">
            <option value="">Todas las marcas</option>
            {brands.map((brand) => <option value={brand}>{brand}</option>)}
          </select>
          <select id="hwSort" class="form-input form-input-sm" aria-label="Ordenar por">
            <option value="default">Ordenar por</option>
            <option value="price-asc">Precio: menor a mayor</option>
            <option value="price-desc">Precio: mayor a menor</option>
            <option value="name-asc">Nombre: A-Z</option>
          </select>
        </div>
        )}

        <div class="hardware-grid" id="hardwareGrid">
          {products.length === 0 ? (
          <p class="section-subtitle">Pronto agregaremos nuevos componentes al catálogo.</p>
          ) : products.map((p) => (
          <article class="hw-card fade-up" data-name={p.name.toLowerCase()} data-brand={p.brand} data-price={p.price}>
            <div class="hw-img-wrap">
              <img src={p.image_url} alt={p.name} class="hw-img" loading="lazy" />
              <div class="hw-img-overlay"></div>
              <span class="hw-brand-badge">{p.brand}</span>
              {p.stock <= 0 && <span class="hw-stock-badge">Agotado</span>}
            </div>
            <div class="hw-info">
              <h3 class="hw-name">{p.name}</h3>
              <p class="hw-desc">{p.description}</p>
              <div class="hw-meta">
                <span class="hw-price">{money(p.price)}</span>
                <span class={`hw-stock ${p.stock <= 0 ? "hw-stock-out" : ""}`}>
                  {p.stock > 0 ? `${p.stock} disponibles` : "Sin stock"}
                </span>
              </div>
            </div>
          </article>
          ))}
        </div>
        <p class="section-subtitle hw-no-results" id="hwNoResults" style="display:none;">No encontramos componentes que coincidan con tu búsqueda.</p>
      </div>
    </section>

