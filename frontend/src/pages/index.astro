            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="M11.5 11.5 15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
