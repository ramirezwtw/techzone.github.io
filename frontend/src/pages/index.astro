---
// Home del sitio público. Los datos vienen de /api/v1/home en una sola llamada.
import Base from "../layouts/Base.astro";
import { api, initials, loadSession, money, shortDate } from "../lib/api";

const session = await loadSession(Astro);
const { products, builds, recent_posts: posts, stats } = await api.home(Astro.request);

// Las marcas del filtro se derivan del catálogo, igual que hacía la plantilla.
const brands = [...new Set(products.map((product) => product.brand))].sort();
---

<Base session={session}>

  <main>


    <!-- ════════════════════════════════════════════════
         HERO — SPLIT LAYOUT
    ═════════════════════════════════════════════════ -->
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-glow hero-glow-1"></div>
        <div class="hero-glow hero-glow-2"></div>
        <div class="hero-grid"></div>
      </div>

      <div class="container hero-split">

        <!-- Left: Text -->
        <div class="hero-content">
          <div class="hero-badge fade-up">
            <span class="badge-dot" aria-hidden="true"></span>
            Plataforma de Asesoría Inteligente de Hardware
          </div>

          <h1 class="hero-title fade-up" id="hero-title">
            Encuentra la PC perfecta
            <span class="gradient-text">para ti sin complicaciones</span>
          </h1>

          <p class="hero-subtitle fade-up">
            TechZone analiza tus necesidades, presupuesto y preferencias para recomendarte
            configuraciones compatibles y optimizadas. Sin tecnicismos, sin estrés.
          </p>

          <div class="hero-actions fade-up">
            <a href="/perfil/armar-pc" class="btn-primary btn-lg">
              Comenzar Asesoría
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="#solucion" class="btn-secondary btn-lg">
              Ver Cómo Funciona
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M6 5.5l4 2.5-4 2.5V5.5z" fill="currentColor"/></svg>
            </a>
          </div>

          <div class="hero-stats fade-up" aria-label="Estadísticas de la plataforma">
            <div class="hero-stat">
              <span class="stat-number">5,000+</span>
              <span class="stat-label">Usuarios activos</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="hero-stat">
              <span class="stat-number">98%</span>
              <span class="stat-label">Compatibilidad garantizada</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="hero-stat">
              <span class="stat-number">12k+</span>
              <span class="stat-label">Configuraciones generadas</span>
            </div>
          </div>
        </div>

        <!-- Right: Image -->
        <div class="hero-image-wrap fade-up" aria-hidden="true">
          <div class="hero-img-frame">
            <img
              src="https://images.pexels.com/photos/30469971/pexels-photo-30469971.jpeg?auto=compress&cs=tinysrgb&w=900"
              alt="Setup gamer moderno con iluminación RGB"
              class="hero-img"
              loading="eager"
            />
            <div class="hero-img-overlay"></div>
          </div>

          <div class="float-card float-card-1">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 2l1.8 5.4H17l-4.5 3.3 1.7 5.3L9 13l-5.2 3 1.7-5.3L1 7.4h6.2L9 2z" fill="#A855F7"/></svg>
            <span>IA Activa</span>
          </div>
          <div class="float-card float-card-2">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 1C4.6 1 1 4.6 1 9s3.6 8 8 8 8-3.6 8-8-3.6-8-8-8z" fill="#22C55E" opacity=".2"/><path d="M6 9l2 2 4-4" stroke="#22C55E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>100% Compatible</span>
          </div>
          <div class="float-card float-card-3">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="4" width="14" height="10" rx="2" stroke="#C084FC" stroke-width="1.5"/><path d="M6 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1" stroke="#C084FC" stroke-width="1.5"/></svg>
            <span>Guardado</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ════════════════════════════════════════════════
         PROBLEMA
    ═════════════════════════════════════════════════ -->
    <section class="section problema" id="problema" aria-labelledby="problema-title">
      <div class="container">
        <div class="section-header fade-up">
          <div class="section-label">El Problema</div>
          <h2 class="section-title" id="problema-title">Elegir componentes nunca<br />ha sido tan difícil</h2>
          <p class="section-subtitle">El mercado de hardware es complejo. La información está fragmentada y una mala elección puede costarte cientos de dólares.</p>
        </div>

        <div class="problems-grid">
          <article class="problem-card fade-up">
            <div class="problem-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <h3 class="problem-title">No sabes qué comprar</h3>
            <p class="problem-desc">Miles de opciones sin saber cuál se adapta realmente a lo que necesitas.</p>
          </article>

          <article class="problem-card fade-up">
            <div class="problem-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke="currentColor" stroke-width="1.5"/><line x1="12" y1="9" x2="12" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="17" r="1" fill="currentColor"/></svg>
            </div>
            <h3 class="problem-title">Incompatibilidades ocultas</h3>
            <p class="problem-desc">Componentes que parecen correctos pero no funcionan juntos. Un error costoso.</p>
          </article>

          <article class="problem-card fade-up">
            <div class="problem-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M2 10h20" stroke="currentColor" stroke-width="1.5"/><path d="M6 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <h3 class="problem-title">Presupuesto limitado</h3>
            <p class="problem-desc">Difícil maximizar el rendimiento sin exceder lo que tienes disponible para invertir.</p>
          </article>

          <article class="problem-card fade-up">
            <div class="problem-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M8 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-2M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M8 6h8" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <h3 class="problem-title">Exceso de opciones</h3>
            <p class="problem-desc">El mercado ofrece cientos de combinaciones. La parálisis por análisis es real.</p>
          </article>

          <article class="problem-card fade-up">
            <div class="problem-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" stroke="currentColor" stroke-width="1.5"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5"/><line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5"/><line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <h3 class="problem-title">Información confusa</h3>
            <p class="problem-desc">Foros dispersos, reviews contradictorias y specs técnicas difíciles de interpretar.</p>
          </article>

          <article class="problem-card fade-up problem-card-highlight">
            <div class="problem-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="16" r="1" fill="currentColor"/></svg>
            </div>
            <h3 class="problem-title">Sin asesoría experta</h3>
            <p class="problem-desc">Nadie disponible 24/7 que te guíe con conocimiento técnico y adapte su consejo a tu caso.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════
         SOLUCIÓN — STEPS
    ═════════════════════════════════════════════════ -->
    <section class="section solucion" id="solucion" aria-labelledby="solucion-title">
      <div class="container">
        <div class="section-header fade-up">
          <div class="section-label">La Solución</div>
          <h2 class="section-title" id="solucion-title">TechZone simplifica<br />todo el proceso</h2>
          <p class="section-subtitle">En cuatro simples pasos obtienes la configuración ideal validada por nuestra inteligencia artificial.</p>
        </div>

        <div class="steps-container">
          <div class="steps-line" aria-hidden="true"></div>
          <div class="steps-grid">

            <article class="step-card fade-up">
              <div class="step-number" aria-hidden="true">01</div>
              <div class="step-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 3C8 3 3 8 3 14s5 11 11 11 11-5 11-11S20 3 14 3z" stroke="currentColor" stroke-width="1.5"/><path d="M14 10v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </div>
              <h3 class="step-title">Crea tu cuenta</h3>
              <p class="step-desc">Regístrate gratis en segundos. Solo necesitas tu email. Sin tarjeta de crédito.</p>
            </article>

            <article class="step-card fade-up">
              <div class="step-number" aria-hidden="true">02</div>
              <div class="step-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="4" y="4" width="20" height="20" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M9 14h10M9 10h10M9 18h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </div>
              <h3 class="step-title">Completa tu asesoría</h3>
              <p class="step-desc">Cuéntanos tu presupuesto, uso y preferencias. Nuestro formulario inteligente hace el resto.</p>
            </article>

            <article class="step-card fade-up">
              <div class="step-number" aria-hidden="true">03</div>
              <div class="step-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 3l3 8h8l-6.5 4.7 2.5 7.8L14 19l-7 4.5 2.5-7.8L3 11h8l3-8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
              </div>
              <h3 class="step-title">Analizamos tus necesidades</h3>
              <p class="step-desc">Nuestra IA procesa tu perfil y valida miles de combinaciones en segundos.</p>
            </article>

            <article class="step-card fade-up">
              <div class="step-number" aria-hidden="true">04</div>
              <div class="step-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M4 14c0-5.5 4.5-10 10-10s10 4.5 10 10-4.5 10-10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M9 14l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <h3 class="step-title">Recibe recomendaciones</h3>
              <p class="step-desc">Obtén configuraciones optimizadas, listas para comprar, con links a tiendas verificadas.</p>
            </article>

          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════
         CARACTERÍSTICAS (con imágenes de fondo en cards)
    ═════════════════════════════════════════════════ -->
    <section class="section caracteristicas" id="caracteristicas" aria-labelledby="feat-title">
      <div class="container">
        <div class="section-header fade-up">
          <div class="section-label">Características</div>
          <h2 class="section-title" id="feat-title">Todo lo que necesitas<br />en una sola plataforma</h2>
          <p class="section-subtitle">TechZone es el ecosistema completo para explorar, comparar y elegir los mejores componentes para tu computadora.</p>
        </div>

        <div class="features-grid">

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/16129724/pexels-photo-16129724.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2C6 2 2 6 2 11s4 9 9 9 9-4 9-9-4-9-9-9z" stroke="currentColor" stroke-width="1.5"/><path d="M8 11l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <h3 class="feature-title">Registro seguro</h3>
            <p class="feature-desc">Crea tu cuenta con email verificado. Datos protegidos con cifrado de extremo a extremo.</p>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/30047570/pexels-photo-30047570.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="7" width="16" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 7V5a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="11" cy="13" r="1.5" fill="currentColor"/></svg></div>
            <h3 class="feature-title">Inicio de sesión</h3>
            <p class="feature-desc">Accede desde cualquier dispositivo con autenticación segura y sesión persistente.</p>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/374006/pexels-photo-374006.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M4 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.5"/><polyline points="22,6 11,13 2,6" stroke="currentColor" stroke-width="1.5"/></svg></div>
            <h3 class="feature-title">Recuperación de contraseña</h3>
            <p class="feature-desc">Restablece el acceso fácilmente con verificación por correo electrónico en segundos.</p>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/12899156/pexels-photo-12899156.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.5"/><circle cx="11" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/></svg></div>
            <h3 class="feature-title">Perfil personalizado</h3>
            <p class="feature-desc">Guarda tus preferencias, historial de asesorías y configuraciones favoritas en tu perfil.</p>
          </article>

          <article class="feature-card fade-up feature-card-featured">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/32260117/pexels-photo-32260117.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2l2.2 6.6H20l-5.6 4.1 2.2 6.6L11 15.2 4.4 19.3l2.2-6.6L1 8.6h6.8L11 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></div>
            <h3 class="feature-title">Asesoría inteligente</h3>
            <p class="feature-desc">Motor de IA que procesa tu perfil completo y genera recomendaciones hiperpersonalizadas en segundos.</p>
            <span class="feature-badge">IA Powered</span>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/36706460/pexels-photo-36706460.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="2" y="3" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <h3 class="feature-title">Recomendaciones automáticas</h3>
            <p class="feature-desc">Recibe múltiples configuraciones ordenadas por relevancia, precio y rendimiento.</p>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/2582937/pexels-photo-2582937.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <h3 class="feature-title">Compatibilidad garantizada</h3>
            <p class="feature-desc">Validamos socket, chipset, TDP y más. Solo configuraciones que funcionan juntas.</p>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/8622911/pexels-photo-8622911.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="2" y="2" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="12" y="2" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="12" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="12" y="12" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.5"/></svg></div>
            <h3 class="feature-title">Comparación de componentes</h3>
            <p class="feature-desc">Compara CPU, GPU, RAM en tablas detalladas. Toma decisiones con información real.</p>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/8353774/pexels-photo-8353774.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" stroke="currentColor" stroke-width="1.5"/><polyline points="17,21 17,13 7,13 7,21" stroke="currentColor" stroke-width="1.5"/><polyline points="7,3 7,8 15,8" stroke="currentColor" stroke-width="1.5"/></svg></div>
            <h3 class="feature-title">Guardado de configuraciones</h3>
            <p class="feature-desc">Guarda y nombra tus builds favoritas. Compártelas con amigos o retómalas cuando quieras.</p>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/16129724/pexels-photo-16129724.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.5"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M23 21v-2a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="1.5"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.5"/></svg></div>
            <h3 class="feature-title">Foro comunitario</h3>
            <p class="feature-desc">Conecta con usuarios expertos, comparte builds y recibe consejos de la comunidad.</p>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/16129728/pexels-photo-16129728.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="9" cy="21" r="1" fill="currentColor"/><circle cx="20" cy="21" r="1" fill="currentColor"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
            <h3 class="feature-title">Integración con tiendas</h3>
            <p class="feature-desc">Links directos a tiendas verificadas con los mejores precios actualizados en tiempo real.</p>
          </article>

          <article class="feature-card fade-up">
            <div class="feature-bg-img" style="background-image:url('https://images.pexels.com/photos/30047570/pexels-photo-30047570.jpeg?auto=compress&cs=tinysrgb&w=800')"></div>
            <div class="feature-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="currentColor" stroke-width="1.5"/><path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="currentColor" stroke-width="1.5"/></svg></div>
            <h3 class="feature-title">Notificaciones por correo</h3>
            <p class="feature-desc">Alertas de disponibilidad, cambios de precio y nuevas recomendaciones a tu inbox.</p>
          </article>

        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════
         HERO SECUNDARIO — T-07
