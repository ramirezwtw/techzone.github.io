              </div>
              <a href={`/builds/${b.id}`} class={`${b.featured ? "btn-primary btn-glow" : "btn-secondary"} btn-lg gaming-cta`}>Ver Build <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7h9M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
