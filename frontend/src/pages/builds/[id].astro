---
// Detalle de una build recomendada.
import Minimal from "../../layouts/Minimal.astro";
import { api, loadSession, notFound } from "../../lib/api";

const { id } = Astro.params;
const session = await loadSession(Astro);
const build = /^\d+$/.test(id ?? "") ? await api.build(id!, Astro.request) : null;

if (!build) {
  return notFound("Build no encontrada.");
}

// El formulario de asesoría sigue en el backend: se precarga por query string.
const solicitar = `/perfil/armar-pc?purpose=Gaming&budget=${encodeURIComponent(
  build.budget_label,
)}&build=${encodeURIComponent(build.name)}`;
---

<Minimal title={`${build.name} — TechZone`} session={session}>
  <a slot="nav" href="/#gaming" class="btn-secondary btn-sm">← Ver todas las builds</a>

  <div class="section-label">{build.tier_emoji} {build.tier}</div>
  <h1 class="profile-title">{build.name}</h1>

  <div class="build-detail-img-wrap">
    <img src={build.image_url} alt={build.name} class="build-detail-img" />
  </div>

  <div class="profile-grid" style="grid-template-columns:1fr 1fr;">
    <div class="profile-info-card">
      <h3 class="profile-card-title">Especificaciones</h3>
      <div class="profile-info-row"><span>Presupuesto</span><strong>{build.budget_label}</strong></div>
      <div class="profile-info-row"><span>Procesador</span><strong>{build.cpu}</strong></div>
      <div class="profile-info-row"><span>Tarjeta gráfica</span><strong>{build.gpu}</strong></div>
      <div class="profile-info-row"><span>RAM</span><strong>{build.ram}</strong></div>
      <div class="profile-info-row"><span>Almacenamiento</span><strong>{build.storage}</strong></div>
    </div>

    <div class="profile-cta-card">
      <h3>¿Te gusta esta build?</h3>
      <p>Rendimiento esperado: {build.performance_note}</p>
      <div class="perf-bar"><div class="perf-fill" style={`width:${build.performance_pct}%`}></div></div>
      <p>Solicita esta configuración y nuestro equipo la ajusta a tu presupuesto y necesidades exactas.</p>
      <a href={solicitar} class="btn-primary btn-lg btn-glow">Solicitar esta build</a>
    </div>
  </div>
</Minimal>
